# Skopiuj do .env i uzupełnij. Plik .env nie trafia do gita.
# LLM: dowolne API zgodne z OpenAI. Domyślnie Scaleway Generative APIs (Paryż, UE), model open-weight gpt-oss-120b.
LLM_API_KEY=
LLM_BASE_URL=https://api.scaleway.ai/v1
LLM_MODEL=gpt-oss-120b
# Lokalnie (on-premise), np. Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=gpt-oss:20b  LLM_API_KEY=ollama
# LLM_ENABLED=0            # 0 = tylko reguły, bez LLM

# Ścieżka do Tesseract OCR, jeśli nie ma go w PATH (Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
