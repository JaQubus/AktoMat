# Ścieżka danych (ZIP-y spraw). Pipeline nie zakłada nazw plików: wrzuć dane UZP do data/uzp/ i uruchom.
DATA_DIR=./data
# LLM przez LiteLLM; zmiana modelu = jedna zmienna (np. ollama/llama3 + LLM_API_BASE=http://localhost:11434)
LLM_MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=
# LLM_API_BASE=
# Tryb offline: tylko cache rejestrów, zero sieci
OFFLINE=0
# Mock KRS dla danych syntetycznych (fikcyjne numery)
MOCK_REGISTRIES=0
