# Skopiuj do .env i uzupełnij. Plik .env nie trafia do gita.
# LLM: dowolne API zgodne z OpenAI. Domyślnie Scaleway Generative APIs (Paryż, UE), model open-weight gpt-oss-120b.
LLM_API_KEY=
LLM_BASE_URL=https://api.scaleway.ai/v1
LLM_MODEL=gpt-oss-120b
# Lokalnie (on-premise), np. Ollama: LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=gpt-oss:20b  LLM_API_KEY=ollama
# Groq (darmowy limit, do testów/ewaluacji; firma z USA - w zgłoszeniu do UZP zostaw dostawcę z UE).
# Linie LLM_* powyżej zostają bez zmian; LLM_PROFILE=groq przełącza na Groq, usunięcie (albo #) wraca do Scaleway.
# LLM_PROFILE=groq
# GROQ_API_KEY=gsk_...
# OVHcloud AI Endpoints (UE, gpt-oss-20b - najlepszy wynik na skanach):
# LLM_PROFILE=ovh
# OVH_API_KEY=...
# CloudFerro Sherlock (UE, m.in. Bielik 11B):
# LLM_PROFILE=sherlock
# SHERLOCK_API_KEY=...
# SHERLOCK_MODEL=speakleash/Bielik-11B-v3.0-Instruct
# LLM_ENABLED=0            # 0 = tylko reguły, bez LLM

# Ścieżka do Tesseract OCR, jeśli nie ma go w PATH (Windows):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Katalog z językami Tesseracta (pol.traineddata), gdy nie ma ich w folderze instalacji:
# TESSDATA_PREFIX=C:\tessdata   (zwykły folder; nie folder z aplikacji Claude/MSIX - Python go nie widzi)
